# Groq API key for the /play chat assistant (api/chat.js reads this name).
# Without it the site works and the board plays; only the chat replies with
# "not configured on this deployment".
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Absolute origin of the deployed site, no trailing slash — e.g.
# https://your-portfolio.vercel.app
#
# Only needed at BUILD time, and only if Vercel's system environment variables
# are not exposed to the build (Settings -> Environment Variables ->
# "Automatically expose System Environment Variables"). vite.config.ts falls
# back to VERCEL_PROJECT_PRODUCTION_URL when that is on.
#
# Worth setting deliberately: canonical, og:url and the whole og:image group are
# gated on this, because Open Graph requires an absolute image URL and there is
# no way to build one from a relative path. With neither variable set the build
# succeeds and the site works, but shared links get no preview image and
# twitter:card quietly degrades from summary_large_image to summary.
SITE_URL=
